# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Only needed for backend/edge functions (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Cohere — used by the resume Q&A backend
COHERE_API_KEY=<your-cohere-key>

# Photo Booth — Google OAuth credentials
# Create at https://console.cloud.google.com/apis/credentials
# App type: Web application
# Authorised redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
